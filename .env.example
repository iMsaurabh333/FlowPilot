# Local development only. Cloud Foundry values come from service bindings.
PORT=4000
AUTH_MODE=mock
MOCK_USER_ID=local-developer
MOCK_USER_NAME=Local Developer
MOCK_USER_SCOPES=ChatUser

# Non-secret model selection. Automated tests use a fake model.
MODEL_PROVIDER=groq
MODEL_NAME=llama-3.3-70b-versatile
MODEL_TEMPERATURE=0
MODEL_MAX_OUTPUT_TOKENS=1024
MODEL_TIMEOUT_MS=30000
MODEL_MAX_RETRIES=2

# Local development only. Leave blank in the repository.
GROQ_API_KEY=
